---
import { displayDate } from '@lib/date';
import { groupNewsletterPosts, newsletterLabels } from '@lib/newsletter';
import { encodeSlug } from '@lib/route';
import type { BlogPost } from 'types/blog';

interface Props {
  posts: BlogPost[];
}
const { posts } = Astro.props;
const groups = groupNewsletterPosts(posts);
---

<section aria-label="技术周报归档" class="space-y-8 px-6 py-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-primary text-sm font-semibold tracking-widest">THE WEEKLY / 技术周报</p>
      <h2 class="mt-2 text-2xl font-bold">值得读，也值得动手试</h2>
      <p class="text-muted-foreground mt-3 text-sm leading-7">周五精选技术动态，周六推荐一篇深度阅读。关注实时渲染、UE、GPU 与 AI 工具链。</p>
    </div>
    <a href="/weekly/rss.xml" data-astro-reload class="text-primary rounded-full border px-4 py-2 text-sm">订阅周报 RSS ↗</a>
  </div>
  <nav aria-label="周报内容类型" class="flex flex-wrap gap-3 text-sm">
    <a href="#digest" class="hover:text-primary rounded-full border px-4 py-2">每周精选 · 周五</a>
    <a href="#long-read" class="hover:text-primary rounded-full border px-4 py-2">深度阅读 · 周六</a>
  </nav>
  {!groups.length && (
    <div class="bg-muted/40 rounded-2xl border px-6 py-10">
      <h3 class="text-lg font-semibold">首期周报即将更新</h3>
      <p class="text-muted-foreground mt-3 text-sm leading-7">每期保留发布日期、原文链接、核心技术与实践价值。发布后将在这里按周归档。</p>
    </div>
  )}
  {(['digest', 'long-read'] as const).map((kind) => (
    <section id={kind} class="scroll-mt-24 space-y-5">
      <h3 class="border-b pb-3 text-xl font-bold">{newsletterLabels[kind]}</h3>
      {groups.filter((group) => group.posts.some((post) => post.data.newsletter?.kind === kind)).map((group) => (
        <div class="grid gap-4">
          <p class="text-muted-foreground text-sm font-semibold">{group.issue.replace('-W', ' · 第 ')} 周</p>
          {group.posts.filter((post) => post.data.newsletter?.kind === kind).map((post) => (
            <article class="bg-muted/30 hover:border-primary rounded-2xl border p-5 transition-colors">
              <p class="text-muted-foreground text-xs">
                <time datetime={post.data.date.toISOString()}>{displayDate.date(post.data.date)}</time>
                {' · '}{post.data.newsletter?.periodStart} — {post.data.newsletter?.periodEnd}
              </p>
              <h4 class="mt-3 text-lg font-semibold">
                <a class="hover:text-primary" href={`/post/${encodeSlug(post.data.link ?? post.id)}`}>{post.data.title}</a>
              </h4>
              <p class="text-muted-foreground mt-3 text-sm leading-7">{post.data.description}</p>
              <a class="text-primary mt-4 inline-block text-sm" href={`/post/${encodeSlug(post.data.link ?? post.id)}`}>阅读全文 →</a>
            </article>
          ))}
        </div>
      ))}
      {!groups.some((group) => group.posts.some((post) => post.data.newsletter?.kind === kind)) && (
        <p class="text-muted-foreground text-sm">暂无已发布的{newsletterLabels[kind]}。</p>
      )}
    </section>
  ))}
</section>
