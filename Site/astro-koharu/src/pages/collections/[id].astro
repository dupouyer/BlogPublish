---
import KnowledgePage from '@components/knowledge/KnowledgePage.astro';
import { getSortedPosts } from '@lib/content';
import { getCollectionPosts } from '@lib/knowledge';
import { topicCollections } from '@lib/knowledge-config';
export async function getStaticPaths() {
  const allPosts = await getSortedPosts();
  return topicCollections.map((group) => ({
    params: { id: group.id },
    props: { group, allPosts, posts: getCollectionPosts(allPosts, group.id) },
  }));
}
const { group, allPosts, posts } = Astro.props;
---
<KnowledgePage group={group} allPosts={allPosts} posts={posts} kind="collection" />
